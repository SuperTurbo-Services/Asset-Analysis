# Copy this file to .env.local for local development or offline macro report
# generation. Never commit keys. The checked-in dashboard and WebMCP tools need none.

# The offline macro refresh calls Workers AI through Cloudflare AI Gateway.
# Use a token with Workers AI Read permission. The deployed Worker uses its AI
# binding and does not need this token or any other model-provider secret.
CLOUDFLARE_API_TOKEN=
