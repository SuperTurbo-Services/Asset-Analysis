# 复制成 .env.local 本地开发用；线上在 Vercel 的 Environment Variables 里配，
# 并且一定要勾 Sensitive。这个文件本身不要填真实值。

# 推荐：Vercel AI Gateway 的 key。只设这一个就能跑，
# 默认走 deepseek/deepseek-v3.2，预算上限在 Vercel 后台管。
AI_GATEWAY_API_KEY=

# 可选：换模型只改这一行。Gateway 上可选 deepseek/deepseek-v3.2、
# alibaba/qwen3.7-plus、zai/glm-4.5、moonshotai/kimi-k2-thinking、
# anthropic/claude-sonnet-5 等 400+ 个。
# AI_MODEL=deepseek/deepseek-v3.2

# 备选：不走 Gateway，直连 DeepSeek 官方时用这两个
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 宏观影响看板 · macro-dashboard
# 复用上面那把 AI_GATEWAY_API_KEY，不需要再加一个 key。
# 模型是分开的：小红书那边看 AI_MODEL，这边看 AI_GATEWAY_MODEL，
# 两个工具各用各的，不要合并成一个变量。
# 可选，默认 zai/glm-4.7。用 npm run macro:models -- glm 查看可用模型。
# 别用 glm-5.3 或 glm-5.2-fast：它们必然思考，网关没有开关能关掉，
# 提示词一长就把全部输出预算用在思考上，正文是空的。
AI_GATEWAY_MODEL=
# Vercel Cron 用它作为 bearer token，生产环境务必设置，否则任何人都能触发付费重建
CRON_SECRET=
# 建好 Blob store 后由 Vercel 自动注入
BLOB_READ_WRITE_TOKEN=
