# Copy this file to .env.local for local development or offline macro report
# generation. Never commit keys. The checked-in dashboard and WebMCP tools need none.

# Vercel AI Gateway is an external model provider, not the site host. This key
# supports `npm run macro:refresh` locally and the Xiaohongshu analysis route.
# In production, set AI_GATEWAY_API_KEY as a Cloudflare Worker secret.
AI_GATEWAY_API_KEY=

# Optional model override for macro report generation.
# The default is zai/glm-4.7.
AI_GATEWAY_MODEL=

# Optional Xiaohongshu analysis overrides. Without AI_GATEWAY_API_KEY, the route
# can use a direct provider key; it returns 503 if no provider key is configured.
AI_MODEL=
AI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
