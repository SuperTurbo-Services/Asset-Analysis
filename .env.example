# Copy this file to .env.local only if you plan to regenerate the static macro
# report. The checked-in dashboard and all WebMCP tools run without credentials.

# Vercel AI Gateway key used by `npm run macro:refresh`.
# Store the production value as a Sensitive Vercel environment variable.
AI_GATEWAY_API_KEY=

# Optional model override for macro report generation.
# The default is zai/glm-4.7.
AI_GATEWAY_MODEL=

# These variables support the pre-existing Xiaohongshu analysis route that is
# preserved in the shared production deployment. They are not required by
# Asset Analysis.
AI_MODEL=
AI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Existing shared-deployment configuration. Do not expose these with a
# NEXT_PUBLIC_ prefix.
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
