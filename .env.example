# 复制成 .env.local 本地开发用；线上在 Vercel 的 Environment Variables 里配，
# 并且一定要勾 Sensitive。这个文件本身不要填真实值。

# 推荐：Vercel AI Gateway 的 key。只设这一个就能跑，
# 默认走 deepseek/deepseek-v3.2，预算上限在 Vercel 后台管。
AI_GATEWAY_API_KEY=

# 可选：换模型只改这一行。Gateway 上可选 deepseek/deepseek-v3.2、
# alibaba/qwen3.7-plus、zai/glm-4.5、moonshotai/kimi-k2-thinking、
# anthropic/claude-sonnet-5 等 400+ 个。
# AI_MODEL=deepseek/deepseek-v3.2

# 备选：不走 Gateway，直连 DeepSeek 官方时用这两个
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
